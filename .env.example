# Declared by voice_agent/pipeline/voice_contracts.py VOICE_ENV_VARS.
# Verified by test_every_declared_env_var_appears_in_env_example.

# self-hosted livekit signal url, ws or wss, never a managed livekit host
LIVEKIT_URL=ws://localhost:7880

# livekit api key used to mint short-lived room-scoped access tokens
LIVEKIT_API_KEY=

# livekit api secret, server side only, never sent to a client
LIVEKIT_API_SECRET=

# openrouter transcription model id, defaults to VOICE_DEFAULT_STT_MODEL
VOICE_STT_MODEL=

# shared openrouter credential used by voice stt and tts
OPENROUTER_API_KEY=

# Qwen Omni realtime (DashScope, Singapore) for the Meet assistant and its judge session
DASHSCOPE_API_KEY=
